# with Cargo, or just serve the static app with ./VocabLearn --start.
*.exe
*.msi
*.dmg
*.AppImage
*.deb
desktop-rs/target/

# Android device debug dumps (large, machine-specific)
app-session-logcat*.txt

# OS / editor noise
.DS_Store
Thumbs.db
*~

